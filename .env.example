APP_NAME="Company Profile Template"
APP_ENV=development
APP_KEY=super_secret_app_key_32_characters_long_min

# Database Configuration
# Supported: sqlite (default for zero-configuration cloning) or mysql
DB_CONNECTION=sqlite
DB_DATABASE=database.sqlite

# Theme Defaults
DEFAULT_PRIMARY_COLOR="#4f46e5"
DEFAULT_SECONDARY_COLOR="#0f172a"
DEFAULT_FONT_FAMILY="Inter"
